{
  "schema_version": 1,
  "id": "twist_apex",
  "description": "FastQSL twist amplitude and core-apex displacement",
  "entrypoint": "nfgs._backend.experiments.nfgs_paper.twist_apex.run",
  "arguments": {
    "field_dir": "{output_root}/rho_full/fields",
    "nfpt_field_dir": "{project_root}/data/nfpt",
    "nfpt_variant": "nfpt_fortran_symmetric",
    "output_dir": "{output_root}/twist_apex",
    "weights": "0,0.5,1"
  },
  "depends_on": [
    "td_rho_scan",
    "archived_inputs"
  ],
  "artifacts": [
    "{output_root}/twist_apex/metrics.csv"
  ],
  "requires_cuda": true,
  "twist_protocol": {
    "plane": "physical y=0",
    "core_fraction": 0.4,
    "apex_window_mm": 70
  }
}
