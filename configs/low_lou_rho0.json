{
  "schema_version": 1,
  "id": "low_lou_rho0",
  "description": "Bottom-driven Low--Lou family baseline at rho=0",
  "entrypoint": "nfgs._backend.experiments.nfgs_paper.analytic_nlfff.run",
  "arguments": {
    "output_dir": "{output_root}/low_lou_baselines/rho0",
    "field_cache_dir": "{output_root}/low_lou_baselines/rho0/fields",
    "benchmarks": "low_lou_c2,low_lou_ll1,low_lou_ll2",
    "mixed_robin_weight": "0",
    "device": "{device}",
    "dtype": "float32",
    "max_iter_lnl": "3000",
    "stop_mode": "sigma_best",
    "tol": "1e-5",
    "patience": "40",
    "sigma_improvement_tol": "1e-5",
    "record_iteration_diagnostics": true
  },
  "depends_on": [
    "preflight"
  ],
  "artifacts": [
    "{output_root}/low_lou_baselines/rho0/metrics.csv"
  ],
  "supports_force": true,
  "profiles": {
    "quick": {
      "arguments": {
        "benchmarks": "low_lou_c2",
        "max_iter_lnl": 3
      }
    }
  },
  "low_lou_cases": {
    "low_lou_c2": {
      "n": 1,
      "m": 1,
      "l": 0.3,
      "psi": 0.47123889803846897
    },
    "low_lou_ll1": {
      "n": 1,
      "m": 1,
      "l": 0.3,
      "psi": 0.7853981633974483
    },
    "low_lou_ll2": {
      "n": 3,
      "m": 1,
      "l": 0.3,
      "psi": 2.5132741228718345
    }
  }
}
