{
  "schema_version": 1,
  "id": "factorized_ablation",
  "description": "One-factor bridge from the predecessor formulation to NFGS",
  "entrypoint": "nfgs._backend.experiments.nfgs_paper.factorized_ablation.run",
  "arguments": {
    "output_dir": "{output_root}/factorized_ablation",
    "device": "{device}",
    "max_iter": "3000",
    "dtype": "float32",
    "patience": "40",
    "sigma_improvement_tol": "1e-5"
  },
  "depends_on": [
    "preflight"
  ],
  "artifacts": [
    "{output_root}/factorized_ablation/metrics_all.csv"
  ],
  "supports_force": true
}
