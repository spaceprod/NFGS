{
  "schema_version": 1,
  "id": "regularization",
  "description": "Alpha limiter and weak-field floor activation audit",
  "entrypoint": "nfgs._backend.experiments.nfgs_paper.regularization.run",
  "arguments": {
    "output_dir": "{output_root}/regularization",
    "device": "{device}",
    "max_iter": "3000",
    "dtype": "float32"
  },
  "depends_on": [
    "preflight"
  ],
  "artifacts": [
    "{output_root}/regularization/regularization_metrics.csv"
  ],
  "supports_force": true
}
