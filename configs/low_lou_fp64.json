{
  "schema_version": 1,
  "id": "low_lou_fp64",
  "description": "Low--Lou precision comparison at rho=0.5",
  "entrypoint": "nfgs._backend.experiments.nfgs_paper.analytic_nlfff.run",
  "arguments": {
    "output_dir": "{output_root}/low_lou_family_rho0p5/float64",
    "field_cache_dir": "{output_root}/low_lou_family_rho0p5/float64/fields",
    "benchmarks": "low_lou_c2,low_lou_ll1,low_lou_ll2",
    "mixed_robin_weight": "0.5",
    "device": "{device}",
    "dtype": "float64",
    "max_iter_lnl": "3000",
    "stop_mode": "sigma_best",
    "tol": "1e-5",
    "patience": "40",
    "sigma_improvement_tol": "1e-5",
    "record_iteration_diagnostics": true
  },
  "depends_on": [
    "preflight"
  ],
  "artifacts": [
    "{output_root}/low_lou_family_rho0p5/float64/metrics.csv"
  ],
  "supports_force": true,
  "low_lou_cases": {
    "low_lou_c2": {
      "n": 1,
      "m": 1,
      "l": 0.3,
      "psi": 0.47123889803846897
    },
    "low_lou_ll1": {
      "n": 1,
      "m": 1,
      "l": 0.3,
      "psi": 0.7853981633974483
    },
    "low_lou_ll2": {
      "n": 3,
      "m": 1,
      "l": 0.3,
      "psi": 2.5132741228718345
    }
  }
}
