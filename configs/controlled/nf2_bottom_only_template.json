{
  "path": "{run_path}",
  "work_path": "{work_path}",
  "logging": {
    "mode": "offline"
  },
  "data": {
    "geometry": "cartesian",
    "normalization": {
      "Mm_per_ds": 1,
      "Gauss_per_dB": 1
    },
    "boundaries": [
      {
        "id": "boundary",
        "type": "numpy",
        "data_path": "{boundary_xy_npz}",
        "Mm_per_pixel": 1,
        "coordinate_center": [
          0,
          0
        ],
        "batch_size": 512
      }
    ],
    "sampler": {
      "type": "height",
      "batch_size": 1024
    },
    "potential_boundary": {
      "type": "none"
    },
    "validation": [
      {
        "id": "boundary",
        "type": "numpy",
        "data_path": "{boundary_xy_npz}",
        "Mm_per_pixel": 1,
        "coordinate_center": [
          0,
          0
        ],
        "batch_size": 512
      }
    ],
    "iterations": 1000,
    "z_range": [
      0,
      2
    ],
    "num_workers": 0
  },
  "model": {
    "field": "vector_potential",
    "network": {
      "type": "siren",
      "hidden_dim": 256,
      "layers": 8,
      "w0": 1,
      "w0_initial": 5
    }
  },
  "training": {
    "epochs": 15,
    "optimizer": {
      "start": 0.0005,
      "end": 5e-05,
      "iterations": 100000
    },
    "validation_interval": 1000,
    "trainer": {
      "devices": 1,
      "accelerator": "gpu",
      "precision": "32-true",
      "max_steps": 15000,
      "matmul_precision": "highest"
    }
  },
  "losses": [
    {
      "type": "boundary",
      "name": "boundary",
      "weight": 1,
      "datasets": [
        "boundary"
      ]
    },
    {
      "type": "force_free",
      "name": "force_free",
      "weight": 0.001,
      "datasets": [
        "random"
      ]
    }
  ],
  "loss_scaling": [],
  "callbacks": []
}
